# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the models used. Any Anthropic model id works.
# The orchestrator does the planning/reasoning; sub-agents do the
# well-specified execution work, so it's usually fine to run them on
# a cheaper model once you've seen the boilerplate work end-to-end.
ORCHESTRATOR_MODEL=claude-opus-5
SUBAGENT_MODEL=claude-sonnet-5

# Optional: path to a local copy of the dataset CSV. If unset/missing,
# it will be downloaded from the UCI ML Repository on first run and
# cached here.
DATA_PATH=data/credit_default.csv
